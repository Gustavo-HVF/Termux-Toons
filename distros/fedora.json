    "atualizar_sistema": ["dnf", "upgrade", "-y"],
    "limpar_cache": ["dnf", "clean", "packages"],
    "remover_orfaos": ["dnf", "autoremove", "-y"],
    "pasta_cache": "/var/cache/dnf",
    "essenciais": ["python", "tmux", "git", "curl", "nano", "pip", "xdg-open", "notify-send"],
