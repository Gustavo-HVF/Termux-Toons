  "caminhos": {
    "downloads": "xdg:DOWNLOAD|~/Downloads",
    "musicas": "xdg:MUSIC|~/Music",
    "videos": "xdg:VIDEOS|~/Videos",
    "imagens": "xdg:PICTURES|~/Pictures",
    "dcim": "xdg:PICTURES|~/Pictures",
    "documentos": "xdg:DOCUMENTS|~/Documents",
    "capturas_de_tela": "xdg:PICTURES/Screenshots|~/Pictures/Screenshots",
    "compartilhado": "~",
    "temporarios": "/tmp",
    "prefixo": "/usr"
  },
  "servicos": {
    "comandos": {
      "iniciar": ["systemctl", "start", "{servico}"],
      "parar": ["systemctl", "stop", "{servico}"],
      "ligar_no_boot": ["systemctl", "enable", "{servico}"],
      "status": ["systemctl", "status", "--no-pager", "{servico}"]
    },
    "nomes": {
      "ssh": "sshd",
      "cron": "crond",
      "mariadb": "mariadb",
      "postgresql": "postgresql"
    },
    "preparar": {
      "postgresql": {
        "se_faltar": "/var/lib/pgsql/data/PG_VERSION",
        "comandos": [["postgresql-setup", "--initdb"]]
      }
    }
  },
  "dicas": {
    "repositorios_extras": "Para o ffmpeg completo, VLC e codecs, ative o RPM Fusion: https://rpmfusion.org/Configuration (no RHEL/Rocky/Alma, ative antes o EPEL: sudo dnf install epel-release)."
  }
}
