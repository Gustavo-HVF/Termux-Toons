{
  "esquema": "lnux-perfil/1",
  "id": "alpine",
  "nome": "Alpine Linux",
  "descricao": "Alpine Linux e postmarketOS (apk, OpenRC)",
  "familia": "linux",
  "detectar": {
    "os_release": ["alpine", "postmarketos"],
    "comandos": ["apk"]
  },
  "recursos": ["adb", "desktop", "servicos_sistema", "distrobox"],
  "elevar": [["doas"], ["sudo"]],
  "pacotes": {
    "gerenciador": "apk",
    "precisa_root": true,
    "instalar": ["apk", "add"],
    "atualizar_indice": ["apk", "update"],
    "atualizar_sistema": ["apk", "upgrade"],
    "limpar_cache": ["sh", "-c", "apk cache clean 2>/dev/null || rm -rf /var/cache/apk/*"],
    "remover_orfaos": null,
    "pasta_cache": "/var/cache/apk",
    "essenciais": ["python", "tmux", "git", "curl", "nano", "pip", "xdg-open", "notify-send"],
    "nomes": {
      "android-tools": "android-tools",
      "aria2": "aria2",
      "binutils": "binutils",
      "browsh": null,
      "clang": "clang",
      "cloudflared": "cloudflared",
      "cmake": "cmake",
      "code-server": null,
      "cronie": "cronie",
      "curl": "curl",
      "deno": "deno",
      "distrobox": "distrobox",
      "espeak-ng": "espeak-ng",
      "fd": "fd",
      "ffmpeg": "ffmpeg",
      "fftw": "fftw-dev",
      "figlet": "figlet",
      "gdb": "gdb",
      "gh": "github-cli",
      "ghostscript": "ghostscript",
      "git": "git",
      "golang": "go",
      "gopls": "gopls",
      "jellyfin-server": null,
      "libqrencode": "libqrencode-tools",
      "libreoffice": "libreoffice",
      "llama-cpp": null,
      "lua-language-server": "lua-language-server",
      "make": "make",
      "mariadb": "mariadb mariadb-client",
      "mpv": "mpv",
      "nano": "nano",
      "navidrome": "navidrome",
      "neovim": "neovim",
      "nmap": "nmap",
      "nmcli": "networkmanager-cli",
      "nodejs": "nodejs npm",
      "nodejs-lts": "nodejs npm",
      "notify-send": "libnotify",
      "openjdk-21": "openjdk21-jre-headless",
      "openssh": "openssh",
      "openssl": "openssl",
      "openssl-tool": "openssl",
      "p7zip": "7zip",
      "pip": "py3-pip",
      "podman": "podman",
      "poppler": "poppler-utils",
      "postgresql": "postgresql16 postgresql16-client",
      "proot": "proot",
      "proot-distro": null,
      "pulseaudio": null,
      "python": "python3",
      "python-cryptography": "py3-cryptography",
      "python-numpy": "py3-numpy",
      "python-onnxruntime": null,
      "python-pillow": "py3-pillow",
      "python-yt-dlp": "yt-dlp",
      "qpdf": "qpdf",
      "rclone": "rclone",
      "ripgrep": "ripgrep",
      "root-repo": null,
      "rust": "rust cargo",
      "rust-analyzer": "rust-analyzer",
      "samba": "samba",
      "scrcpy": null,
      "syncthing": "syncthing",
      "tcpdump": "tcpdump",
      "termux-api": null,
      "termux-tools": null,
      "termux-x11-nightly": null,
      "tesseract": "tesseract-ocr",
      "tmux": "tmux",
      "tor": "tor",
      "traceroute": null,
      "tur-repo": null,
      "virglrenderer-android": null,
      "vlc": "vlc",
      "w3m": "w3m",
      "wget": "wget",
      "wireguard-tools": "wireguard-tools",
      "wl-clipboard": "wl-clipboard",
      "x11-repo": null,
      "xclip": "xclip",
      "xdg-open": "xdg-utils",
      "yt-dlp-ejs": null,
      "zbar": "zbar"
    },
    "modulos_python": {
      "cryptography": "py3-cryptography",
      "flask": "py3-flask",
      "mutagen": "py3-mutagen",
      "numpy": "py3-numpy",
      "pillow": "py3-pillow",
      "rich": "py3-rich",
      "uvicorn": "py3-uvicorn",
      "yt-dlp": "yt-dlp"
    }
  },
  "caminhos": {
    "downloads": "xdg:DOWNLOAD|~/Downloads",
    "musicas": "xdg:MUSIC|~/Music",
    "videos": "xdg:VIDEOS|~/Videos",
    "imagens": "xdg:PICTURES|~/Pictures",
    "dcim": "xdg:PICTURES|~/Pictures",
    "documentos": "xdg:DOCUMENTS|~/Documents",
    "capturas_de_tela": "xdg:PICTURES/Screenshots|~/Pictures/Screenshots",
    "compartilhado": "~",
    "temporarios": "/tmp",
    "prefixo": "/usr"
  },
  "servicos": {
    "comandos": {
      "iniciar": ["rc-service", "{servico}", "start"],
      "parar": ["rc-service", "{servico}", "stop"],
      "ligar_no_boot": ["rc-update", "add", "{servico}", "default"],
      "status": ["rc-service", "{servico}", "status"]
    },
    "nomes": {
      "ssh": "sshd",
      "cron": "crond",
      "mariadb": "mariadb",
      "postgresql": "postgresql"
    },
    "preparar": {
      "mariadb": {
        "se_faltar": "/var/lib/mysql/mysql",
        "comandos": [["/etc/init.d/mariadb", "setup"]]
      },
      "postgresql": {
        "se_faltar": "/var/lib/postgresql",
        "comandos": [["/etc/init.d/postgresql", "setup"]]
      }
    }
  },
  "dicas": {
    "repositorios_extras": "Muitos programas ficam no repositório 'community': confira se ele está ativo em /etc/apk/repositories."
  }
}
