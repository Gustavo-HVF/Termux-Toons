{
  "esquema": "lnux-perfil/1",
  "id": "arch",
  "nome": "Arch Linux",
  "descricao": "Arch, Manjaro, EndeavourOS, Garuda, CachyOS, Artix, SteamOS e outras derivadas",
  "familia": "linux",
  "detectar": {
    "os_release": ["arch", "manjaro", "endeavouros", "garuda", "cachyos", "artix", "arcolinux", "steamos"],
    "comandos": ["pacman"]
  },
  "recursos": ["adb", "desktop", "servicos_sistema", "distrobox"],
  "elevar": [["sudo"], ["doas"]],
  "pacotes": {
    "gerenciador": "pacman",
    "precisa_root": true,
    "instalar": ["pacman", "-S", "--needed", "--noconfirm"],
    "atualizar_indice": null,
    "atualizar_sistema": ["pacman", "-Syu", "--noconfirm"],
    "limpar_cache": ["pacman", "-Sc", "--noconfirm"],
    "remover_orfaos": ["sh", "-c", "pacman -Qdtq | pacman -Rns --noconfirm - || true"],
    "pasta_cache": "/var/cache/pacman/pkg",
    "essenciais": ["python", "tmux", "git", "curl", "nano", "pip", "xdg-open", "notify-send"],
    "nomes": {
      "android-tools": "android-tools",
      "aria2": "aria2",
      "binutils": "binutils",
      "browsh": null,
      "clang": "clang",
      "cloudflared": "cloudflared",
      "cmake": "cmake",
      "code-server": null,
      "cronie": "cronie",
