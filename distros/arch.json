      "x11-repo": null,
      "xclip": "xclip",
      "xdg-open": "xdg-utils",
      "yt-dlp-ejs": null,
      "zbar": "zbar"
    },
    "modulos_python": {
      "cryptography": "python-cryptography",
      "fastapi": "python-fastapi",
      "flask": "python-flask",
      "mutagen": "python-mutagen",
      "numpy": "python-numpy",
      "onnxruntime": "python-onnxruntime",
      "pillow": "python-pillow",
      "rich": "python-rich",
      "textual": "python-textual",
      "uvicorn": "uvicorn",
      "yt-dlp": "yt-dlp"
    }
  },
  "caminhos": {
    "downloads": "xdg:DOWNLOAD|~/Downloads",
    "musicas": "xdg:MUSIC|~/Music",
    "videos": "xdg:VIDEOS|~/Videos",
    "imagens": "xdg:PICTURES|~/Pictures",
    "dcim": "xdg:PICTURES|~/Pictures",
    "documentos": "xdg:DOCUMENTS|~/Documents",
    "capturas_de_tela": "xdg:PICTURES/Screenshots|~/Pictures/Screenshots",
    "compartilhado": "~",
    "temporarios": "/tmp",
    "prefixo": "/usr"
  },
  "servicos": {
    "comandos": {
      "iniciar": ["systemctl", "start", "{servico}"],
      "parar": ["systemctl", "stop", "{servico}"],
      "ligar_no_boot": ["systemctl", "enable", "{servico}"],
      "status": ["systemctl", "status", "--no-pager", "{servico}"]
    },
    "nomes": {
      "ssh": "sshd",
      "cron": "cronie",
      "mariadb": "mariadb",
      "postgresql": "postgresql"
    },
    "preparar": {
      "mariadb": {
        "se_faltar": "/var/lib/mysql/mysql",
        "comandos": [["mariadb-install-db", "--user=mysql", "--basedir=/usr", "--datadir=/var/lib/mysql"]]
      },
      "postgresql": {
        "se_faltar": "/var/lib/postgres/data/PG_VERSION",
        "comandos": [["runuser", "-u", "postgres", "--", "initdb", "-D", "/var/lib/postgres/data"]]
      }
    }
  },
  "dicas": {
    "repositorios_extras": "Programas que não estão nos repositórios oficiais (code-server, browsh...) ficam no AUR: instale um ajudante como o yay ou o paru."
  }
}
