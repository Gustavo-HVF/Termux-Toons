      "fftw": "fftw",
      "figlet": "figlet",
      "gdb": "gdb",
      "gh": "github-cli",
      "ghostscript": "ghostscript",
      "git": "git",
      "golang": "go",
      "gopls": "gopls",
      "jellyfin-server": "jellyfin-server jellyfin-web",
      "libqrencode": "qrencode",
      "libreoffice": "libreoffice-fresh",
      "llama-cpp": null,
      "lua-language-server": "lua-language-server",
      "make": "make",
      "mariadb": "mariadb",
      "mpv": "mpv",
      "nano": "nano",
      "navidrome": "navidrome",
      "neovim": "neovim",
      "nmap": "nmap",
      "nmcli": "networkmanager",
      "nodejs": "nodejs npm",
      "nodejs-lts": "nodejs-lts-iron npm",
      "notify-send": "libnotify",
      "openjdk-21": "jre21-openjdk-headless",
      "openssh": "openssh",
      "openssl": "openssl",
      "p7zip": "7zip",
      "pip": "python-pip",
      "podman": "podman",
      "poppler": "poppler",
      "postgresql": "postgresql",
      "proot": "proot",
      "proot-distro": null,
      "pulseaudio": null,
      "python": "python",
      "python-cryptography": "python-cryptography",
      "python-numpy": "python-numpy",
      "python-onnxruntime": "python-onnxruntime",
      "python-pillow": "python-pillow",
      "python-yt-dlp": "yt-dlp",
      "qpdf": "qpdf",
      "rclone": "rclone",
      "ripgrep": "ripgrep",
      "root-repo": null,
      "rust": "rust",
      "rust-analyzer": "rust-analyzer",
      "samba": "samba",
      "scrcpy": "scrcpy",
      "syncthing": "syncthing",
      "tcpdump": "tcpdump",
      "termux-api": null,
      "termux-tools": null,
      "termux-x11-nightly": null,
      "tesseract": "tesseract tesseract-data-eng tesseract-data-por",
      "tmux": "tmux",
      "tor": "tor",
      "traceroute": "traceroute",
      "tur-repo": null,
      "virglrenderer-android": null,
      "vlc": "vlc",
      "w3m": "w3m",
