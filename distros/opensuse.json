{
  "esquema": "lnux-perfil/1",
  "id": "opensuse",
  "nome": "openSUSE",
  "descricao": "openSUSE Tumbleweed, openSUSE Leap e SUSE Linux Enterprise (zypper)",
  "familia": "linux",
  "detectar": {
    "os_release": ["opensuse", "opensuse-tumbleweed", "opensuse-leap", "opensuse-slowroll", "sles", "suse"],
    "comandos": ["zypper"]
  },
  "recursos": ["adb", "desktop", "servicos_sistema", "distrobox"],
  "elevar": [["sudo"], ["doas"]],
  "pacotes": {
    "gerenciador": "zypper",
    "precisa_root": true,
    "instalar": ["zypper", "--non-interactive", "install"],
    "atualizar_indice": ["zypper", "--non-interactive", "refresh"],
    "atualizar_sistema": ["zypper", "--non-interactive", "update"],
    "limpar_cache": ["zypper", "clean", "--all"],
    "remover_orfaos": null,
    "pasta_cache": "/var/cache/zypp/packages",
    "essenciais": ["python", "tmux", "git", "curl", "nano", "pip", "xdg-open", "notify-send"],
    "nomes": {
      "android-tools": "android-tools",
      "aria2": "aria2",
      "binutils": "binutils",
      "browsh": null,
      "clang": "clang",
      "cloudflared": null,
      "cmake": "cmake",
      "code-server": null,
      "cronie": "cronie",
