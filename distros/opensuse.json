      "xclip": "xclip",
      "xdg-open": "xdg-utils",
      "yt-dlp-ejs": null,
      "zbar": "zbar"
    },
    "modulos_python": {
      "cryptography": "python3-cryptography",
      "fastapi": "python3-fastapi",
      "flask": "python3-Flask",
      "mutagen": "python3-mutagen",
      "numpy": "python3-numpy",
      "pillow": "python3-Pillow",
      "rich": "python3-rich",
      "uvicorn": "python3-uvicorn",
      "yt-dlp": "yt-dlp"
    }
  },
  "caminhos": {
    "downloads": "xdg:DOWNLOAD|~/Downloads",
    "musicas": "xdg:MUSIC|~/Music",
    "videos": "xdg:VIDEOS|~/Videos",
    "imagens": "xdg:PICTURES|~/Pictures",
    "dcim": "xdg:PICTURES|~/Pictures",
    "documentos": "xdg:DOCUMENTS|~/Documents",
    "capturas_de_tela": "xdg:PICTURES/Screenshots|~/Pictures/Screenshots",
    "compartilhado": "~",
    "temporarios": "/tmp",
    "prefixo": "/usr"
  },
  "servicos": {
    "comandos": {
      "iniciar": ["systemctl", "start", "{servico}"],
      "parar": ["systemctl", "stop", "{servico}"],
      "ligar_no_boot": ["systemctl", "enable", "{servico}"],
      "status": ["systemctl", "status", "--no-pager", "{servico}"]
    },
    "nomes": {
      "ssh": "sshd",
      "cron": "cron",
      "mariadb": "mariadb",
      "postgresql": "postgresql"
    }
  },
  "dicas": {
    "repositorios_extras": "Para codecs e o ffmpeg completo, ative o Packman: https://en.opensuse.org/Additional_package_repositories#Packman . No Tumbleweed, prefira 'sudo zypper dup' para atualizar."
  }
}
