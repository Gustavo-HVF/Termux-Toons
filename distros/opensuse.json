      "deno": null,
      "distrobox": "distrobox",
      "espeak-ng": "espeak-ng",
      "fd": "fd",
      "ffmpeg": "ffmpeg",
      "fftw": "fftw3-devel",
      "figlet": "figlet",
      "gdb": "gdb",
      "gh": "gh",
      "ghostscript": "ghostscript",
      "git": "git",
      "golang": "go",
      "gopls": "gopls",
      "jellyfin-server": null,
      "libqrencode": "qrencode",
