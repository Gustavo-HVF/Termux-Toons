      "llama-cpp": null,
      "lua-language-server": null,
      "make": "make",
      "mariadb": "mariadb",
      "mpv": "mpv",
      "nano": "nano",
      "navidrome": null,
      "neovim": "neovim",
      "nmap": "nmap",
      "nmcli": "NetworkManager",
      "nodejs": "nodejs-default npm-default",
      "nodejs-lts": "nodejs-default npm-default",
      "notify-send": "libnotify-tools",
      "openjdk-21": "java-21-openjdk-headless",
      "openssh": "openssh",
      "openssl": "openssl",
      "openssl-tool": "openssl",
      "p7zip": "7zip",
      "pip": "python3-pip",
      "podman": "podman",
      "poppler": "poppler-tools",
      "postgresql": "postgresql-server postgresql",
      "proot": "proot",
      "proot-distro": null,
      "pulseaudio": null,
      "python": "python3",
      "python-cryptography": "python3-cryptography",
      "python-numpy": "python3-numpy",
      "python-onnxruntime": null,
      "python-pillow": "python3-Pillow",
      "python-yt-dlp": "yt-dlp",
      "qpdf": "qpdf",
      "rclone": "rclone",
      "ripgrep": "ripgrep",
      "root-repo": null,
      "rust": "rust cargo",
      "rust-analyzer": null,
      "samba": "samba",
      "scrcpy": "scrcpy",
      "syncthing": "syncthing",
      "tcpdump": "tcpdump",
      "termux-api": null,
      "termux-tools": null,
      "termux-x11-nightly": null,
      "tesseract": "tesseract-ocr",
      "tmux": "tmux",
      "tor": "tor",
      "traceroute": "traceroute",
      "tur-repo": null,
      "virglrenderer-android": null,
      "vlc": "vlc",
      "w3m": "w3m",
      "wget": "wget",
      "wireguard-tools": "wireguard-tools",
